# Deadlockprohunger environment (docs/QA.md § Deployment). Copy to .env.local; never commit real values.
# Everything is optional: without them the site runs on the public API with no database.

# Deadlock API key, sent server-side as X-API-KEY (raises rate limits). Never exposed to the browser.
DEADLOCK_API_KEY=

# Postgres (Neon) for history, snapshots and fallbacks. Without it, pages use the live API only.
DATABASE_URL=

# Shared secret sent as "Authorization: Bearer <secret>" to /api/cron/* by Vercel Cron and by the hourly
# GitHub Actions prewarm (.github/workflows/prewarm.yml, which reads the same value from the repo's
# Actions secret CRON_SECRET). Every cron job, prewarm included, refuses to run without it.
# Generate a long random value (e.g. `openssl rand -hex 32`); never commit it.
CRON_SECRET=

# Production origin (scheme + host, no trailing slash), server-side: metadataBase, canonical and hreflang links,
# sitemap.xml entries and the robots.txt sitemap line (src/i18n/seo.ts). Unset = none of these are emitted,
# so local builds and previews never advertise a guessed host. Set it for the Production environment only,
# e.g. SITE_URL=https://deadlock-pro-hunger.vercel.app (same name as the GitHub Actions variable for prewarm).
SITE_URL=

# Google Search Console HTML-tag verification value (the content="…" of google-site-verification), server-side.
# Rendered as that meta tag on every page; unset or blank = no tag. Read at build: redeploy after changing it.
GOOGLE_SITE_VERIFICATION=

# "off" replaces all game art with original fallbacks (asset kill switch). Build-time: rebuild after changing.
NEXT_PUBLIC_GAME_ASSETS=

# Diagnostics only
# DEADLOCK_API_BASE_URL=https://api.deadlock-api.com   # point at a stub for fault tests
# DEADLOCK_API_TRACE=1                                   # log every upstream call (docs/PERFORMANCE.md)
